rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The app stores everything for one logged-in user in a single
    // document at ledgers/{their uid}. Only that user may read or write it.
    match /ledgers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
